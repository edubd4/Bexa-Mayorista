# Copialo como .env.local y completá los valores
# cp env.example .env.local

# ========================================
# SUPABASE
# Dashboard -> Project Settings -> API
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ========================================
# APP CONFIG
# ========================================
NEXT_PUBLIC_APP_NAME=BEXA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# ANTHROPIC API — SOLO si el blueprint dice ia: true
# (módulos ia-chat / ia-avisos del catálogo; se cotizan aparte)
# ========================================
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ========================================
# FACTURACIÓN ELECTRÓNICA AFIP/ARCA (0031)
# El CUIT emisor y el punto de venta son DATO (tabla configuracion).
# Acá van SOLO los secretos del canal.
# ========================================
# Token de app.afipsdk.com (cuenta gratuita — plan Free: 1 CUIT, 1000 req/mes)
AFIP_SDK_ACCESS_TOKEN=
# "true" SOLO en producción con certificado real; vacío/false = homologación
AFIP_PRODUCTION=false
# Certificado X.509 y clave privada en PEM — SOLO producción.
# En Vercel: pegar el contenido completo del PEM (soporta multilínea).
# La clave privada la generamos nosotros y JAMÁS sale de acá / Vercel.
# AFIP_CERT=
# AFIP_KEY=
